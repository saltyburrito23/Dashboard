APP_KEY=your_schwab_app_key
APP_SECRET=your_schwab_app_secret
CALLBACK_URL=https://127.0.0.1
DEFAULT_SYMBOL=SPY
DEFAULT_MIN_DTE=0
DEFAULT_MAX_DTE=30
DEFAULT_STRIKE_WINDOW=8
DEFAULT_STRIKE_COUNT=50
DEFAULT_REFRESH_SECONDS=30
HISTORY_PERIOD_TYPE=day
HISTORY_PERIOD=1
HISTORY_FREQUENCY_TYPE=minute
HISTORY_FREQUENCY=5
# When VIX1D is unavailable: annualized IV proxy = VIX * this (0DTE-oriented).
VIX_ODTE_MULTIPLIER=1.15
